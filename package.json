{
  "name": "schoolpulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "node scripts/check-prod-safety.mjs",
    "test": "vitest run",
    "test:e2e": "node --env-file=.env.local scripts/seed-dev.mjs && playwright test",
    "test:security": "vitest run tests/unit/production-safety.test.ts && node --test tests/check-script.test.mjs && npm run test:rls",
    "check:main": "node scripts/check-prod-safety.mjs --branch main",
    "db:migrate": "supabase db push",
    "db:seed": "node --env-file=.env.local scripts/seed-dev.mjs",
    "db:reset": "supabase db reset && node --env-file=.env.local scripts/seed-dev.mjs",
    "typecheck": "tsc --noEmit",
    "test:prod": "node --env-file=.env.local node_modules/@playwright/test/cli.js test -c playwright.prod.config.ts",
    "test:all": "npm run typecheck && npm run test && npm run test:security && npm run test:e2e",
    "prepare:main": "node scripts/prepare-main.mjs",
    "test:rls": "node --env-file=.env.local node_modules/vitest/vitest.mjs run -c vitest.rls.config.ts",
    "verify:prod-db": "node scripts/verify-prod-db.mjs",
    "supabase:start": "supabase start -x edge-runtime,logflare,vector,imgproxy,studio,mailpit,realtime"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.105.3",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "^1.68.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}