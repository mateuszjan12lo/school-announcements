# PRODUKCJA (Vercel Production / gałąź main). Osobny projekt Supabase. Ustaw w panelu Vercel, nie w pliku w repozytorium.
APP_ENV=production
NEXT_PUBLIC_APP_URL=https://twoja-domena.example
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-produkcyjny>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<klucz anon produkcji>
SUPABASE_SERVICE_ROLE_KEY=<klucz service_role produkcji – tylko serwer, nigdy NEXT_PUBLIC_>
# MUSZĄ BYĆ NIEUSTAWIONE w produkcji: DEBUG, SEED_ENV, DEV_ADMIN_EMAIL, DEV_ADMIN_PASSWORD, RUN_DEV_SEED
